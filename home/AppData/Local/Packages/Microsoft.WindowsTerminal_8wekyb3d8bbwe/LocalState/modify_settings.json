{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merges .windowsTerminal (.chezmoidata/terminal.yaml) into the existing
  settings.json. Everything not managed here is kept as is.
*/ -}}
{{- $wt := .windowsTerminal -}}
{{- $s := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $s = fromJsonc .chezmoi.stdin -}}
{{- end -}}

{{- /*
  actions, keybindings and schemes keep their existing order (Windows Terminal
  reorders them when saving from the UI): managed entries are replaced
  in place, duplicates dropped, and missing ones appended.
*/ -}}

{{- /* actions, matched by id */ -}}
{{- $managed := dict -}}
{{- range $wt.actions -}}
{{-   $_ := set $managed .id . -}}
{{- end -}}
{{- $seen := dict -}}
{{- $actions := list -}}
{{- range (get $s "actions" | default list) -}}
{{-   $id := get . "id" | toString -}}
{{-   if not (hasKey $managed $id) -}}
{{-     $actions = append $actions . -}}
{{-   else if not (hasKey $seen $id) -}}
{{-     $actions = append $actions (get $managed $id) -}}
{{-     $_ := set $seen $id true -}}
{{-   end -}}
{{- end -}}
{{- range $wt.actions -}}
{{-   if not (hasKey $seen .id) -}}
{{-     $actions = append $actions . -}}
{{-   end -}}
{{- end -}}
{{- $s = set $s "actions" $actions -}}

{{- /* keybindings, matched by keys */ -}}
{{- $managed = dict -}}
{{- range $wt.keybindings -}}
{{-   $_ := set $managed (lower .keys) . -}}
{{- end -}}
{{- $seen = dict -}}
{{- $bindings := list -}}
{{- range (get $s "keybindings" | default list) -}}
{{-   $k := "" -}}
{{-   if kindIs "string" (get . "keys") -}}
{{-     $k = lower (get . "keys") -}}
{{-   end -}}
{{-   if not (hasKey $managed $k) -}}
{{-     $bindings = append $bindings . -}}
{{-   else if not (hasKey $seen $k) -}}
{{-     $bindings = append $bindings (get $managed $k) -}}
{{-     $_ := set $seen $k true -}}
{{-   end -}}
{{- end -}}
{{- range $wt.keybindings -}}
{{-   if not (hasKey $seen (lower .keys)) -}}
{{-     $bindings = append $bindings . -}}
{{-   end -}}
{{- end -}}
{{- $s = set $s "keybindings" $bindings -}}

{{- /* color schemes, matched by name */ -}}
{{- $wantSchemes := dig "schemes" list $wt -}}
{{- $managed = dict -}}
{{- range $wantSchemes -}}
{{-   $_ := set $managed .name . -}}
{{- end -}}
{{- $seen = dict -}}
{{- $schemes := list -}}
{{- range (get $s "schemes" | default list) -}}
{{-   $name := get . "name" | toString -}}
{{-   if not (hasKey $managed $name) -}}
{{-     $schemes = append $schemes . -}}
{{-   else if not (hasKey $seen $name) -}}
{{-     $schemes = append $schemes (get $managed $name) -}}
{{-     $_ := set $seen $name true -}}
{{-   end -}}
{{- end -}}
{{- range $wantSchemes -}}
{{-   if not (hasKey $seen .name) -}}
{{-     $schemes = append $schemes . -}}
{{-   end -}}
{{- end -}}
{{- $s = set $s "schemes" $schemes -}}

{{- /* profiles.defaults */ -}}
{{- range $path, $value := $wt.profileDefaults -}}
{{-   $s = setValueAtPath (printf "profiles.defaults.%s" $path) $value $s -}}
{{- end -}}

{{- /* drop per-profile overrides so every profile inherits from defaults */ -}}
{{- $profiles := dig "profiles" "list" list $s -}}
{{- if $profiles -}}
{{-   $list := list -}}
{{-   range $profiles -}}
{{-     $p := . -}}
{{-     range $wt.enforceOnAllProfiles -}}
{{-       $p = deleteValueAtPath . $p -}}
{{-     end -}}
{{-     if and (hasKey $p "font") (empty (get $p "font")) -}}
{{-       $p = unset $p "font" -}}
{{-     end -}}
{{- /* per-profile settings: every key in `match` must equal the profile's value */ -}}
{{-     range (dig "profiles" list $wt) -}}
{{-       $matches := true -}}
{{-       range $k, $v := .match -}}
{{-         if ne (get $p $k | toString) (toString $v) -}}
{{-           $matches = false -}}
{{-         end -}}
{{-       end -}}
{{-       if $matches -}}
{{-         range $k, $v := .set -}}
{{-           $p = setValueAtPath $k $v $p -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     $list = append $list $p -}}
{{-   end -}}
{{-   $s = setValueAtPath "profiles.list" $list $s -}}
{{- end -}}

{{- /* nothing changed: return the file untouched to keep Windows Terminal's formatting */ -}}
{{- if and (trim .chezmoi.stdin) (eq (toJson $s) (toJson (fromJsonc .chezmoi.stdin))) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson "    " $s }}
{{ end -}}
