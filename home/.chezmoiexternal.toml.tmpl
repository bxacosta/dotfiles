{{- /*
  Tools installed from their GitHub releases into ~/.local/bin, on Linux only
  (on Windows they come from winget, see .chezmoidata/packages.yaml).
  No sudo needed. URLs use releases/latest, so each refresh gets the newest
  version; refreshPeriod makes `chezmoi apply` re-download at most weekly.
  bat's and mise's asset names include the version, so their URLs come from
  the GitHub API. mise is updated here, not with `mise self-update`.
*/ -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $starshipArch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch -}}
{{-   $fastfetchArch := get (dict "amd64" "amd64" "arm64" "aarch64") .chezmoi.arch -}}
{{-   $miseArch := get (dict "amd64" "x64" "arm64" "arm64") .chezmoi.arch -}}
{{-   $batAsset := printf "bat-*-%s-unknown-linux-musl.tar.gz" $starshipArch -}}
{{-   $miseAsset := printf "mise-v*-linux-%s-musl.tar.gz" $miseArch -}}

[".local/bin/starship"]
type = "archive-file"
url = "https://github.com/starship/starship/releases/latest/download/starship-{{ $starshipArch }}-unknown-linux-musl.tar.gz"
path = "starship"
executable = true
refreshPeriod = "168h"

[".local/bin/fastfetch"]
type = "archive-file"
url = "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-{{ $fastfetchArch }}.tar.gz"
path = "fastfetch-linux-{{ $fastfetchArch }}/usr/bin/fastfetch"
executable = true
refreshPeriod = "168h"

[".local/bin/bat"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "sharkdp/bat" $batAsset | quote }}
path = "bat"
stripComponents = 1
executable = true
refreshPeriod = "168h"

[".local/bin/mise"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "jdx/mise" $miseAsset | quote }}
path = "mise/bin/mise"
executable = true
refreshPeriod = "168h"
{{- end }}
