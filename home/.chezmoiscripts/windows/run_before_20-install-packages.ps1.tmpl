{{- /*
  Installs the winget packages in .chezmoidata/packages.yaml.
  Installed packages are detected while rendering (command found in PATH):
  if nothing is missing the script renders empty and chezmoi skips it.

  A terminal opened before an install still has the old PATH, so a package
  can look missing when it is not; winget's "already installed" codes are
  therefore treated as success.
*/ -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $missing := list -}}
{{-   range .packages.winget -}}
{{-     if not (lookPath .command) -}}
{{-       $missing = append $missing . -}}
{{-     end -}}
{{-   end -}}
{{-   if $missing -}}
$ErrorActionPreference = 'Stop'

# 0x8A150061: package already installed; 0x8A15002B: no applicable upgrade
$alreadyInstalled = @(0x8A150061, 0x8A15002B) | ForEach-Object { [int32]$_ }

{{     range $missing -}}
Write-Host 'Installing {{ .id }}...'
winget install --id {{ .id | quote }} --exact --source winget --silent --disable-interactivity --accept-package-agreements --accept-source-agreements
if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -notin $alreadyInstalled) { throw "winget failed to install {{ .id }} (exit code $LASTEXITCODE)" }

{{     end -}}
Write-Host 'Open a new terminal to pick up PATH changes.'
{{-   end -}}
{{- end -}}
