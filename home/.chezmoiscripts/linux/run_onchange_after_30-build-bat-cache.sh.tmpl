{{- /*
  Rebuilds bat's cache, which is where bat reads custom themes from.
  Runs again whenever the theme changes (its hash is below).
*/ -}}
{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Aurora.tmTheme hash: {{ include ".chezmoitemplates/bat/Aurora.tmTheme" | sha256sum }}
set -e

bat=$(command -v bat || echo "$HOME/.local/bin/bat")
if [ -x "$bat" ]; then
    "$bat" cache --build >/dev/null
fi
{{- end -}}
